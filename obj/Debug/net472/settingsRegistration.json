{
  "categories": {
    "spectral": {
      "title": "%Spectral.Settings.Category%"
    }
  },
  "properties": {
    "spectral.enable": {
      "type": "boolean",
      "default": true,
      "title": "%Spectral.Settings.Enable%",
      "description": "%Spectral.Settings.Enable.Description%"
    },
    "spectral.rulesetFile": {
      "type": "string",
      "default": "",
      "title": "%Spectral.Settings.RulesetFile%",
      "description": "%Spectral.Settings.RulesetFile.Description%"
    },
    "spectral.runMode": {
      "enum": [
        "onSave",
        "onType"
      ],
      "enumItemLabels": [
        "%Spectral.Settings.RunMode.OnSave%",
        "%Spectral.Settings.RunMode.OnType%"
      ],
      "type": "string",
      "default": "onSave",
      "title": "%Spectral.Settings.RunMode%",
      "description": "%Spectral.Settings.RunMode.Description%"
    },
    "spectral.validateFiles": {
      "items": {
        "type": "string"
      },
      "allowItemEditing": true,
      "allowAdditionsAndRemovals": true,
      "type": "array",
      "default": [
        "**/*.yaml",
        "**/*.yml",
        "**/*.json"
      ],
      "title": "%Spectral.Settings.ValidateFiles%",
      "description": "%Spectral.Settings.ValidateFiles.Description%"
    },
    "spectral.spectralPath": {
      "type": "string",
      "default": "spectral",
      "title": "%Spectral.Settings.SpectralPath%",
      "description": "%Spectral.Settings.SpectralPath.Description%"
    }
  }
}